# VulnPath AI — Environment Configuration Example
# Copy this file to .env and configure your environment variables.
# Never commit your actual .env file to source control.

# Optional LLM Provider API Keys (for future API integration)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# LLM Configuration Defaults
LLM_MODEL=default-model
LLM_TEMPERATURE=0.0
